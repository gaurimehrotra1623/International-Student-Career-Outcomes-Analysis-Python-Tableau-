      <aliases enabled='yes' />
      <column caption='Age Group' datatype='string' name='[Age_Group]' role='dimension' type='nominal' />
      <column caption='Salary Band ' datatype='string' name='[Calculation_0145954941816833]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Salary] &lt; 30000 THEN &quot;Low&quot;&#10;ELSEIF [Salary] &lt; 70000 THEN &quot;Medium&quot;&#10;ELSE &quot;High&quot;&#10;END' />
      </column>
      <column caption='Employment Rate' datatype='integer' name='[Calculation_0145954942009346]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Employment_Status] = &quot;Employed&quot; THEN 1&#10;ELSE 0&#10;END' />
      </column>
      <column caption='Internship Label' datatype='string' name='[Calculation_0145954942091267]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Internship_Experience] = &quot;Yes&quot; THEN &quot;Internship&quot;&#10;ELSE &quot;No Internship&quot;&#10;END' />
      </column>
      <column caption='Years Since Graduation Group' datatype='string' name='[Calculation_0145954942357508]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Years_Since_Graduation] &lt;= 2 THEN &quot;0-2 Years&quot;&#10;ELSEIF [Years_Since_Graduation] &lt;= 5 THEN &quot;3-5 Years&quot;&#10;ELSE &quot;6+ Years&quot;&#10;END' />
      </column>
      <column caption='Total Records' datatype='integer' name='[Calculation_0145954945327109]' role='measure' type='quantitative'>
